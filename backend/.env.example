# Application
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL)
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
DATABASE_NAME=secretary
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=10
# SSL mode for asyncpg: disable (local dev), prefer, require (production w/ certs)
DATABASE_SSLMODE=disable

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Milvus (Vector Database)
MILVUS_HOST=localhost
MILVUS_PORT=19530

# Neo4j (Graph Database, Optional)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# LLM Providers
# Provider options: openai, dashscope, anthropic
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-xxxxxxxxxxxxx
OPENAI_API_BASE=https://api.openai.com/v1
LLM_MODEL=gpt-4o
EMBEDDING_MODEL=text-embedding-3-small

# Dashscope (Alibaba Cloud) Configuration
# Get API key from: https://dashscope.console.aliyun.com/apiKey
DASHSCOPE_API_KEY=sk-xxxxxxxxxxxxx
# Voice streaming (real-time ASR via Dashscope WebSocket)
VOICE_STREAMING_ENABLED=true
# Base URL for Dashscope Responses API (OpenAI Compatible)
# OPENAI_API_BASE=https://dashscope.aliyuncs.com/api/v2/apps/protocols/compatible-mode/v1
# Recommended Qwen models:
# - qwen3-max-2026-01-23 (most powerful)
# - qwen3-plus-2026-01-23 (balanced)
# - qwen3-turbo-2026-01-23 (fast & cost-effective)
# LLM_MODEL=qwen3-max-2026-01-23
# Dashscope embedding models:
# - text-embedding-v2
# EMBEDDING_MODEL=text-embedding-v2

# Anthropic Configuration
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Bi-modal Routing Models
# Haiku for fast intent classification and simple queries
INTENT_ROUTER_MODEL=claude-3-haiku-20240307
FAST_WORKER_MODEL=claude-3-haiku-20240307

# Encryption (CHANGE IN PRODUCTION)
ENCRYPTION_MASTER_KEY=change_this_to_a_32_byte_key_12

# JWT Authentication (CHANGE IN PRODUCTION)
JWT_SECRET=change_this_in_production_secret
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# CORS
CORS_ORIGINS=[]

# Logging
LOG_LEVEL=INFO
SENTRY_DSN=

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
RATE_LIMIT_PER_MINUTE_UNAUTH=10

# Curation strategy tuning
CURATION_ASSOCIATION_TOP_K=8
CURATION_ASSOCIATION_MIN_CONFIDENCE=0.5
CURATION_ASSOCIATION_MIN_TITLE_CHARS=3
CURATION_ASSOCIATION_MIN_REASON_CHARS=8
CURATION_LOW_INFORMATION_ASSOCIATION_LIMIT=1
CURATION_LOW_IMPORTANCE_EVENT_TYPES=["holiday_solar_term","solar_term"]
CURATION_CONFLICT_WINDOW_DAYS=7
CURATION_AUTO_RESOLVE_BUFFER_DAYS=1
CURATION_MAX_AUTO_RESOLVE_OFFSET_DAYS=90
CURATION_WEEKEND_TRIP_KEYWORDS=["周末"]
CURATION_STALE_CONTACT_DAYS=90
CURATION_STALE_CONTACT_MIN_IMPORTANCE=5

# Celery (auto-derived from REDIS_HOST/PORT/DB if left unset)
# CELERY_BROKER_URL=
# CELERY_RESULT_BACKEND=

# ASR (Automatic Speech Recognition)
# Provider options: whisper (OpenAI), dashscope (Alibaba SenseVoice/Paraformer)
ASR_PROVIDER=whisper
# ASR_MODEL=               # empty = provider default (whisper-1 / sensevoice-v1)
# ASR_DEFAULT_LANGUAGE=     # empty = auto-detect, e.g. "zh" for Chinese
# ASR_MAX_AUDIO_SIZE_MB=10

# Agent Worker Mode
# true  = Agent Worker runs inside the uvicorn process (convenient for dev)
# false = Agent Worker must be started separately via ./scripts/start-agent-worker.sh
# In production, always use false so uvicorn restarts don't kill CLI processes.
RUN_AGENT_WORKER_IN_PROCESS=true

# Session Affinity / Worker Heartbeat (Phase 6)
SESSION_AFFINITY_TTL_SECONDS=1800
WORKER_HEARTBEAT_TTL_SECONDS=30
WORKER_HEARTBEAT_INTERVAL_SECONDS=10
SESSION_MAILBOX_ENABLED=true
SESSION_MAILBOX_IDLE_SECONDS=120
# 0 means unbounded
SESSION_MAILBOX_MAX_QUEUE_SIZE=0
# Session streaming-input actor for pooled slow/hybrid execution
SDK_STREAMING_INPUT_ENABLED=true
SDK_STREAMING_INPUT_IDLE_SECONDS=120
# SDK stream idle timeout (seconds). 0 disables idle timeout.
AGENT_IDLE_TIMEOUT_SECONDS=0
